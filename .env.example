# Supabase (Project Settings → API Keys). Server-only: no NEXT_PUBLIC_ prefix.
SUPABASE_URL=
# Publishable key (sb_publishable_…): safe by design; every table is protected by RLS/grants.
SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): bypasses RLS. NEVER prefix it with NEXT_PUBLIC_ or share it.
SUPABASE_SECRET_KEY=

# Admin panel: the only email allowed in (the account is created in Supabase → Authentication → Users).
# Login = email + password + 6-digit code from an authenticator app (MFA).
ADMIN_EMAIL=

# Cloudflare Turnstile anti-bot. The site key must reach the browser (NEXT_PUBLIC_). The secret key goes in
# Supabase → Authentication → Bot and Abuse Protection, not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Public URL of the site (absolute links in shared-page previews and invitation links)
SITE_URL=http://localhost:3000
